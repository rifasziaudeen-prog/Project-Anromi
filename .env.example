PROJECT_NAME="Project Anromi API"
DATABASE_URL="sqlite+aiosqlite:///./anromi.db"

# ── Narration (The Heavenly Dao) — free-tier LLM fallback chains ──
# Providers are tried in NARRATION_PROVIDERS order; within each provider,
# its MODELS list is tried left-to-right before moving to the next provider.
NARRATION_PROVIDERS="groq,gemini,openrouter"

# Groq — https://console.groq.com/keys (free, no credit card)
GROQ_API_KEY=""
# openai/gpt-oss-120b: flagship MoE reasoning | gpt-oss-20b: high-speed lightweight
# groq/compound-mini: fast server-side orchestrator (groq/compound = full agentic tools)
GROQ_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,groq/compound-mini"

# Google AI Studio — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=""
GEMINI_MODELS="gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash"

# OpenRouter — https://openrouter.ai/keys (:free model IDs rotate — check openrouter.ai/models)
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="meta-llama/llama-3.1-8b-instruct:free"

NARRATION_TIMEOUT_SECONDS=20

# ── Discord Bot (bot/run via: python run_bot.py) ──
DISCORD_BOT_TOKEN=""
API_BASE_URL="http://127.0.0.1:8000"
ANNOUNCE_CHANNEL_ID=""

# ── Deployment / CORS ──
# Comma-separated browser origins allowed to call this API.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ── Supabase (v0.7.0 production DB) ──
# Paste your Postgres connection string (Project Settings → Database → URI).
# Local SQLite stays the default when left empty:
DATABASE_URL="sqlite+aiosqlite:///./anromi.db"
